    "click_rects": [
      {"label": "Save Report", "probe": "calib_canvas_report.txt", "body": "calib-canvas report"},
      {"label": "Export Data", "probe": "calib_canvas_export.txt", "body": "calib-canvas export"}
    ],
    "must_correlate_seeds": ["CalibCanvas", "Export"]
