{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "reversing-mcp",
  "description": "Static binary analysis and Directmedia decompression MCP. Pair with ReVa MCP for Ghidra-backed decompilation and listings.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 3.1+",
  "tools": 13,
  "version": "0.4.0",
  "transport": ["stdio"],
  "keywords": [
    "reverse-engineering",
    "ghidra",
    "radare2",
    "binary-analysis",
    "decompiler",
    "forensics",
    "malware-analysis",
    "directmedia",
    "fastmcp",
    "free-tools"
  ],
  "features": {
    "binary_analysis": {
      "enabled": true,
      "tools": ["ghidra", "radare2", "binwalk", "file", "strings"]
    },
    "decompression": {
      "enabled": true,
      "formats": ["directmedia-dki"]
    },
    "testing_framework": {
      "enabled": true,
      "methodology": "compilation-decompilation-comparison"
    }
  }
}
